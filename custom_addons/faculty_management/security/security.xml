<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!--security group faculty member-->
    <record id="faculty_management.group_faculty_member" model="res.groups">
        <field name="name">Faculty Member</field>
    </record>    

    <!--security group faculty admin-->
    <record id="faculty_management.group_faculty_admin" model="res.groups">
        <field name="name">Faculty Admin</field>
        <field name="implied_ids" eval="[(4, ref('faculty_management.group_faculty_member'))]"/>
    </record>

    <!--security rule for faculty members only seeing their own personal info-->    
    <record id="faculty_member_rule_self" model="ir.rule">
        <field name="name">Faculty Members can only see their own data</field>
        <field name="model_id" ref="model_faculty_member"/>
        <field name="groups" eval="[(4, ref('faculty_management.group_faculty_member'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <!--security rule for faculty admins being able to see all info-->
    <record id="faculty_member_rule_admin" model="ir.rule">
        <field name="name">Faculty Admins can see all faculty members</field>
        <field name="model_id" ref="model_faculty_member"/>
        <field name="groups" eval="[(4, ref('faculty_management.group_faculty_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[]</field>
    </record> 

    <!--security rule for faculty members to only see their own leave requests-->
    <record id="faculty_leave_rule_self" model="ir.rule">
        <field name="name">Faculty Members can only see their own leave requests</field>
        <field name="model_id" ref="model_faculty_leave"/>
        <field name="groups" eval="[(4, ref('faculty_management.group_faculty_member'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>


    <!--security rule for faculty admin to be able to see all leave-->
    <record id="faculty_leave_rule_admin" model="ir.rule">
        <field name="name">Faculty Admins can manage all leave requests</field>
        <field name="model_id" ref="model_faculty_leave"/>
        <field name="groups" eval="[(4, ref('faculty_management.group_faculty_admin'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
        <field name="domain_force">[]</field>
    </record>

















</odoo>