<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <record id="faculty_member_own_rule" model="ir.rule">
        <field name="name">Faculty Members: View Own Records</field>
        <field name="model_id" ref="model_faculty_member"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('faculty_management.group_faculty_member'))]"/>
    </record>

    <record id="faculty_admin_rule" model="ir.rule">
        <field name="name">Faculty Admin: View All Records</field>
        <field name="model_id" ref="model_faculty_member"/>
        <field name="global" eval="False"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('faculty_management.group_faculty_admin'))]"/>
    </record>
</odoo>
